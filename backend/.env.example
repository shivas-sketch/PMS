# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200

# --- Firebase / Firestore ---
# Project ID from the Firebase console (matches the web config you were given).
FIREBASE_PROJECT_ID=smart-hospital-parking
# Path to a service-account JSON key (Project Settings -> Service Accounts ->
# Generate new private key). Required for firebase-admin to write to Firestore
# unless you are using the emulator below.
FIREBASE_CREDENTIALS_PATH=
# Alternative for local dev without real GCP credentials: run
#   firebase emulators:start --only firestore
# and point the app at it - no service account needed.
FIRESTORE_EMULATOR_HOST=

# --- Model paths (leave defaults to auto-download the small COCO model) ---
VEHICLE_MODEL_PATH=yolov8n.pt
# Optional dedicated license-plate YOLO model. Leave empty to use the
# built-in OpenCV heuristic fallback.
LICENSE_PLATE_MODEL_PATH=models/plate_model/license_plate.pt
VEHICLE_CLASSIFIER_MODEL_PATH=
# Trained LPRNet for end-to-end plate recognition (replaces PaddleOCR when set)
LPRNET_MODEL_PATH=models/plate_model/lprnet.pth

# --- OCR ---
OCR_ENGINE=paddleocr
OCR_LANGUAGES=en

# --- Confidence thresholds ---
VEHICLE_CONFIDENCE_THRESHOLD=0.50
PLATE_CONFIDENCE_THRESHOLD=0.50
OCR_CONFIDENCE_THRESHOLD=0.60

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp

# --- Parking ---
DEFAULT_TOTAL_CAPACITY=100
